#cloud-config

# --- 1. EXECUTION (runcmd runs as root by default) ---
runcmd:
  # Create the target directory
  - mkdir -p /var/tmp/k3s-setup
  # Ensure the script is executable
  - chmod +x /var/tmp/k3s-setup/k3s-install-server.sh
  # Execute the single script file
  - /var/tmp/k3s-setup/k3s-install-server.sh

# --- 2. WRITE FILES TO DISK ---
write_files:
  - path: /var/tmp/k3s-setup/k3s-install-server.sh
    owner: root:root
    permissions: '0755'
    content: |
      ${install_script}
# --- Dynamic Modular Scripts ---
  # This loop automatically generates a write_files entry 
  # for every script found in your init_common and init_server directories.
%{ for script in modular_scripts ~}
  - path: ${script.path}
    owner: root:root
    permissions: '0755'
    content: |
      ${indent(6, script.content)}
%{ endfor ~}